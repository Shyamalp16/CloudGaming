{
  "name": "scalable-signaling-server",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node ScalableSignalingServer.js",
    "dev": "cross-env PRETTY_LOGS=true node ScalableSignalingServer.js",
    "health": "node -e \"require('./health').startHealthServer({})\"",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "test": "jest --config jest.unit.config.js --runInBand",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "ci": "npm ci && npm run format && npm run lint && npm test && npm run test:integration"
  },
  "dependencies": {
    "axios": "1.18.0",
    "dotenv": "16.6.1",
    "express": "5.2.1",
    "jose": "5.10.0",
    "jsonwebtoken": "9.0.2",
    "pino": "9.9.0",
    "pino-pretty": "11.3.0",
    "prom-client": "15.1.3",
    "redis": "5.6.0",
    "ws": "8.21.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "cross-env": "10.1.0",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.7.0",
    "jest": "30.4.2",
    "prettier": "3.9.6"
  }
}
