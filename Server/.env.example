# Local/LAN defaults. Copy to .env and replace placeholders.
NODE_ENV=development
REDIS_URL=redis://127.0.0.1:6379
WS_PORT=3002
MATCHMAKER_PORT=3000
HOST_SECRET=replace-with-at-least-32-random-characters
PAIRING_TOKEN_SECRET=use-a-different-32-character-random-key
ENABLE_SESSION_AUTH=false
REQUIRE_WSS=false

# Production-only examples:
# NODE_ENV=production
# ENABLE_SESSION_AUTH=true
# REQUIRE_WSS=true
# ALLOWED_ORIGINS=https://play.example.com
# METERED_DOMAIN=example.metered.live
# METERED_API_KEY=replace-from-secret-manager
