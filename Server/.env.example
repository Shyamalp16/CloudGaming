# Local defaults. Copy to .env and replace placeholders.
NODE_ENV=development
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=cg:v1:
BIND_HOST=127.0.0.1
WS_PORT=3002
MATCHMAKER_PORT=3000
HEALTH_PORT=8081
HOST_CREDENTIALS_JSON={"00000000-0000-4000-8000-000000000000":"replace-with-at-least-32-random-characters"}
PAIRING_TOKEN_SECRET=use-a-different-32-character-random-key
METRICS_SECRET=use-another-32-character-random-key
ENABLE_SESSION_AUTH=true
SUBPROTOCOL=cloud-gaming-v1
REQUIRE_WSS=false
ALLOWED_ORIGINS=http://127.0.0.1:8000

# Production-only examples:
# NODE_ENV=production
# ENABLE_SESSION_AUTH=true
# REQUIRE_WSS=true
# ALLOWED_ORIGINS=https://play.example.com
# BIND_HOST=0.0.0.0
# TRUSTED_PROXY_IPS=10.0.0.10
# METERED_DOMAIN=example-tenant
# METERED_API_KEY=replace-from-secret-manager
